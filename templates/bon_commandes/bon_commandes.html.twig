{% extends 'base.html.twig' %}

{% block title %}Bons de commande{% endblock %}

{% block onload %} onload="" {% endblock %}

{% block body %}
    <div class="text-center">
        <h1>Bons de commande</h1>
    </div>

    <input type="text" id="searchId" class="form-control search-box" placeholder="Rechercher par id"><br> ou <br>
    <input type="text" id="searchName" class="form-control search-box" placeholder="Rechercher par nom "><br>
    <div class="d-flex justify-content-between">
        <a href="/stockMenu" class="btn btn-success">
            <span class="material-symbols-outlined">
                arrow_back
            </span>Revenir au menu précedent
        </a>
        <a href="{{path('app_bon_commande_addPage')}}" class="btn btn-primary">
            <span class="material-symbols-outlined">
                add
            </span>Ajouter bon de commande
        </a>
    </div>
    <br>
    <table class="table display" id="example">
        <thead>
            <tr>
                <th>N° de bon</th>
                <th>Fournisseur</th>
                <th>Date d'émission</th>
                <th>Réception totale</th>
                <th>Éléments de commande</th>
            </tr>
        </thead>
        <tbody id="bonCommandeList">
            {# dynamiclly #}
        </tbody>
    </table>

    <!-- Modal Bootstrap pour modifier le bon de commande -->
    <div class="modal fade" id="editBonCommandeModal" tabindex="-1" aria-labelledby="editBonCommandeModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editBonCommandeModalLabel">Modifier le Bon de Commande</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="editBonCommandeForm">
                        <input type="hidden" id="editBonCommandeId">
                        <div class="form-group">
                            <label for="editFournisseur">Fournisseur :</label>
                            <select class="form-control" id="editFournisseur">
                                <!-- Fournisseurs options will be dynamically populated -->
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="editOrderDate">Date d'émission :</label>
                            <input type="date" class="form-control" id="editOrderDate">
                        </div>
                        <div class="form-group">
                            <label for="editIsFullyReceived">Réception totale :</label>
                            <input type="checkbox" id="editIsFullyReceived">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    <button type="button" class="btn btn-primary" id="modifyBonCommandeBtn" data-bs-dismiss="modal"
                        onclick="updateBonCommande()">Modifier</button>
                </div>
            </div>
        </div>
    </div>

    

<!-- Modal -->
<div class="modal fade" id="detailsBonCommandeModal" tabindex="-1" aria-labelledby="detailsBonCommandeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl"> <!-- Adjust modal-dialog size to 'modal-xl' for extra large -->
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h5 class="modal-title" id="detailsBonCommandeModalLabel">Éléments de la commande</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <!-- Modal Body -->
      <div class="modal-body">
        <div class="table-responsive"> <!-- Wrap table inside 'table-responsive' for scrollbars -->
          <table class="table table-bordered"> <!-- Add 'table-bordered' for borders -->
            <thead>
              <tr>

                <th scope="col">Produit</th>
                <th scope="col">Quantité</th>
                <th scope="col">Unité d'achat</th>
                <th scope="col">Informations additionnelles</th>
              </tr>
            </thead>
            <tbody id="detailsBonCommandeTableBody">
              <!-- Dynamic rows will be inserted here -->
              
            </tbody>
          </table>
        </div>
      </div>
      <!-- Modal Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block jss %}
    {{ parent() }}
    <script src="{{ asset('js/bonCommande.js') }}"></script>
    <script>
    let bonCommandes =  getAllBonCommandes();
    
    async function fetchTable(){
        bonCommandes = await getAllBonCommandes();
        displayBonCommandeInTable(bonCommandes);
    }
    document.addEventListener('DOMContentLoaded', async function() {
    fetchTable();
    });
</script>
<script src="{{ asset('js/bonCommande.js') }}"></script>
{% endblock %}
