{# warehousesList.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Entrepôts{% endblock %}

{% block onload %} onload="displayWarehouses()" {% endblock %}

{% block body %}
<div class="text-center">
    <h1>Entrepôts</h1>
</div>

<input type="text" id="searchId" class="form-control search-box" placeholder="Rechercher par ID"><br> ou <br>
<input type="text" id="searchName" class="form-control search-box" placeholder="Rechercher par nom "><br>
<div class="d-flex justify-content-between">
    <a href="{{ path('app_stocks_manag_menu') }}" class="btn btn-success">
        <span class="material-symbols-outlined">
            arrow_back
        </span>Revenir à la page d'accueil
    </a>
    <a href="#" onclick="displayWarehouses()" class="btn btn-warning">Actualiser</a>
    <a href="{{ path('app_warehouse_add_form') }}" class="btn btn-primary">
        <span class="material-symbols-outlined">
            add
        </span>Ajouter entrepôt
    </a>
</div>
<br>
<table class="table display" id="example">
    <thead>
        <tr>
            <th scope="col">Label</th>
            <th scope="col">Adresse</th>
            <th scope="col">Ville</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody id="warehouseList">
        <!-- Les entrepôts seront ajoutés ici dynamiquement -->
    </tbody>
</table>

<!-- Modal Bootstrap pour modifier un entrepôt -->
<div class="modal fade" id="editWarehouseModal" tabindex="-1" aria-labelledby="editWarehouseModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editWarehouseModalLabel">Modifier l'Entrepôt</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="editWarehouseForm">
                    <!-- Champ de saisie pour le label de l'entrepôt -->
                    <input type="hidden" id="editWarehouseId">
                    <div class="form-group">
                        <label for="editWarehouseLabel">Label de l'entrepôt :</label>
                        <input type="text" class="form-control" id="editWarehouseLabel"
                            placeholder="Entrer le label de l'entrepôt">
                    </div>

                    <!-- Champ de saisie pour l'adresse -->
                    <div class="form-group">
                        <label for="editWarehouseAddress">Adresse :</label>
                        <input type="text" class="form-control" id="editWarehouseAddress"
                            placeholder="Entrer l'adresse de l'entrepôt">
                    </div>

                    <!-- Champ de saisie pour la ville -->
                    <div class="form-group">
                        <label for="editWarehouseCity">Ville :</label>
                        <input type="text" class="form-control" id="editWarehouseCity"
                            placeholder="Entrer la ville de l'entrepôt">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-primary" id="modifyWarehouseBtn" data-bs-dismiss="modal"
                    onclick="updateWarehouse()">Modifier</button>
            </div>
        </div>
    </div>
</div>




{% endblock %}

{% block jss %}
{{ parent() }}
<script src="{{ asset('js/warehouse.js') }}"></script>
{% endblock %}